<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test tool: turns fixtures/MiniPlant/interop/MiniPlant.Interop.Sim's DLL into the IJW metadata shape
       the C++/CLI compiler produces, so the bridge extractor can be tested without MSVC. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
