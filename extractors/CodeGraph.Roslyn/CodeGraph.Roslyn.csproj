<Project Sdk="Microsoft.NET.Sdk">
  <!-- Component A: C# extractor (SPEC 5). Loads solutions with MSBuildWorkspace and walks Roslyn operations.
       No Microsoft.Build.Locator here: Workspaces.MSBuild 5.x evaluates projects in its own BuildHost
       processes (BuildHost-netcore for SDK projects, BuildHost-net472 + Visual Studio MSBuild for legacy
       projects on Windows), and each BuildHost locates MSBuild itself. See docs/DECISIONS.md D-01. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodeGraph.Shared\CodeGraph.Shared.csproj" />
  </ItemGroup>
</Project>
